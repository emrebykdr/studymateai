<Application x:Class="StudyMateAI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Material Design Dark Base -->
                <materialDesign:BundledTheme BaseTheme="Dark"
                                             PrimaryColor="Teal"
                                             SecondaryColor="Teal"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══════════════════════════════════════════════
                 DARK MODE COLOR PALETTE
            ═══════════════════════════════════════════════ -->
            <!-- Backgrounds -->
            <Color x:Key="BgDeepColor">#0D1117</Color>
            <Color x:Key="BgSurfaceColor">#161B22</Color>
            <Color x:Key="BgCardColor">#1C2128</Color>
            <Color x:Key="BgHoverColor">#21262D</Color>
            <Color x:Key="BgBorderColor">#30363D</Color>

            <!-- Accent - Teal/Cyan -->
            <Color x:Key="AccentColor">#2DD4BF</Color>
            <Color x:Key="AccentDarkColor">#0F766E</Color>
            <Color x:Key="AccentLightColor">#5EEAD4</Color>

            <!-- Text -->
            <Color x:Key="TextPrimaryColor">#E6EDF3</Color>
            <Color x:Key="TextSecondaryColor">#8B949E</Color>
            <Color x:Key="TextMutedColor">#484F58</Color>

            <!-- Status Colors -->
            <Color x:Key="DangerColor">#F85149</Color>
            <Color x:Key="SuccessColor">#3FB950</Color>
            <Color x:Key="WarningColor">#D29922</Color>
            <Color x:Key="InfoColor">#58A6FF</Color>

            <!-- Button Colors -->
            <Color x:Key="BtnPrimaryColor">#238636</Color>
            <Color x:Key="BtnPrimaryHoverColor">#2EA043</Color>
            <Color x:Key="BtnPrimaryBorderColor">#3FB950</Color>
            <Color x:Key="BtnSecondaryColor">#21262D</Color>
            <Color x:Key="BtnSecondaryHoverColor">#30363D</Color>
            <Color x:Key="BtnDangerColor">#B91C1C</Color>
            <Color x:Key="BtnDangerHoverColor">#DC2626</Color>

            <!-- Legacy compat brushes (used in existing views) -->
            <Color x:Key="VoidBlueColor">#0D1117</Color>
            <Color x:Key="SlateDarkColor">#1C2128</Color>
            <Color x:Key="CyberTealColor">#2DD4BF</Color>
            <Color x:Key="NeonCoralColor">#F85149</Color>
            <Color x:Key="StarlightColor">#E6EDF3</Color>
            <Color x:Key="MoonGrayColor">#8B949E</Color>
            <Color x:Key="GlassBorderColor">#30363D</Color>

            <!-- ═══════════════════════════════════════════════
                 BRUSHES
            ═══════════════════════════════════════════════ -->
            <SolidColorBrush x:Key="BgDeepBrush"      Color="{StaticResource BgDeepColor}"/>
            <SolidColorBrush x:Key="BgSurfaceBrush"   Color="{StaticResource BgSurfaceColor}"/>
            <SolidColorBrush x:Key="BgCardBrush"      Color="{StaticResource BgCardColor}"/>
            <SolidColorBrush x:Key="BgHoverBrush"     Color="{StaticResource BgHoverColor}"/>
            <SolidColorBrush x:Key="BgBorderBrush"    Color="{StaticResource BgBorderColor}"/>
            <SolidColorBrush x:Key="AccentBrush"      Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="AccentDarkBrush"  Color="{StaticResource AccentDarkColor}"/>
            <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
            <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="TextMutedBrush"     Color="{StaticResource TextMutedColor}"/>
            <SolidColorBrush x:Key="DangerBrush"    Color="{StaticResource DangerColor}"/>
            <SolidColorBrush x:Key="SuccessBrush"   Color="{StaticResource SuccessColor}"/>
            <SolidColorBrush x:Key="WarningBrush"   Color="{StaticResource WarningColor}"/>
            <SolidColorBrush x:Key="InfoBrush"      Color="{StaticResource InfoColor}"/>

            <!-- Legacy brushes for existing views -->
            <SolidColorBrush x:Key="VoidBlueBrush"    Color="{StaticResource VoidBlueColor}"/>
            <SolidColorBrush x:Key="SlateDarkBrush"   Color="{StaticResource SlateDarkColor}"/>
            <SolidColorBrush x:Key="CyberTealBrush"   Color="{StaticResource CyberTealColor}"/>
            <SolidColorBrush x:Key="NeonCoralBrush"   Color="{StaticResource NeonCoralColor}"/>
            <SolidColorBrush x:Key="StarlightBrush"   Color="{StaticResource StarlightColor}"/>
            <SolidColorBrush x:Key="MoonGrayBrush"    Color="{StaticResource MoonGrayColor}"/>
            <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource GlassBorderColor}"/>
            <SolidColorBrush x:Key="CyanGeometricBrush" Color="{StaticResource AccentColor}"/>

            <!-- ═══════════════════════════════════════════════
                 MATERIAL DESIGN OVERRIDES (Dark)
            ═══════════════════════════════════════════════ -->
            <SolidColorBrush x:Key="MaterialDesignPaper"                    Color="{StaticResource BgDeepColor}"/>
            <SolidColorBrush x:Key="MaterialDesignBackground"               Color="{StaticResource BgDeepColor}"/>
            <SolidColorBrush x:Key="MaterialDesignCardBackground"           Color="{StaticResource BgCardColor}"/>
            <SolidColorBrush x:Key="MaterialDesignComboBoxPopupBackground"  Color="{StaticResource BgCardColor}"/>
            <SolidColorBrush x:Key="MaterialDesignListBoxBackground"        Color="Transparent"/>
            <SolidColorBrush x:Key="MaterialDesignPaperBackground"          Color="{StaticResource BgCardColor}"/>
            <SolidColorBrush x:Key="MaterialDesignToolBarBackground"        Color="{StaticResource BgSurfaceColor}"/>
            <SolidColorBrush x:Key="MaterialDesignTextFieldBoxBackground"          Color="{StaticResource BgCardColor}"/>
            <SolidColorBrush x:Key="MaterialDesignTextFieldBoxHoverBackground"     Color="{StaticResource BgHoverColor}"/>
            <SolidColorBrush x:Key="MaterialDesignTextFieldBoxDisabledBackground"  Color="{StaticResource BgSurfaceColor}"/>
            <SolidColorBrush x:Key="MaterialDesignSelection"  Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="MaterialDesignBody"       Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="MaterialDesignBodyLight"  Color="{StaticResource TextSecondaryColor}"/>

            <!-- ═══════════════════════════════════════════════
                 EASING & ANIMATIONS
            ═══════════════════════════════════════════════ -->
            <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

            <!-- ═══════════════════════════════════════════════
                 BUTTON CONTROL TEMPLATE (CUSTOM DARK)
                 Completely replaces Material Design's white button
            ═══════════════════════════════════════════════ -->
            <ControlTemplate x:Key="DarkButtonTemplate" TargetType="{x:Type Button}">
                <Border x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">
                    <ContentPresenter x:Name="PART_Content"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"
                                      TextBlock.Foreground="{TemplateBinding Foreground}"
                                      TextBlock.FontWeight="{TemplateBinding FontWeight}"
                                      TextBlock.FontSize="{TemplateBinding FontSize}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="PART_Border" Property="Opacity" Value="0.85"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="PART_Border" Property="Opacity" Value="0.7"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="PART_Border" Property="Opacity" Value="0.4"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- ═══════════════════════════════════════════════
                 PRIMARY BUTTON - Dark Green
            ═══════════════════════════════════════════════ -->
            <Style TargetType="{x:Type Button}">
                <Setter Property="Template"    Value="{StaticResource DarkButtonTemplate}"/>
                <Setter Property="Background"  Value="#238636"/>
                <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="#3FB950"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight"  Value="SemiBold"/>
                <Setter Property="FontSize"    Value="13"/>
                <Setter Property="Padding"     Value="14,7"/>
                <Setter Property="Cursor"      Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <!-- ═══════════════════════════════════════════════
                 SECONDARY / GHOST BUTTON
            ═══════════════════════════════════════════════ -->
            <Style x:Key="SecondaryButton" TargetType="{x:Type Button}">
                <Setter Property="Template"    Value="{StaticResource DarkButtonTemplate}"/>
                <Setter Property="Background"  Value="#21262D"/>
                <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BgBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight"  Value="SemiBold"/>
                <Setter Property="FontSize"    Value="13"/>
                <Setter Property="Padding"     Value="14,7"/>
                <Setter Property="Cursor"      Value="Hand"/>
            </Style>

            <!-- ═══════════════════════════════════════════════
                 DANGER BUTTON
            ═══════════════════════════════════════════════ -->
            <Style x:Key="DangerButton" TargetType="{x:Type Button}">
                <Setter Property="Template"    Value="{StaticResource DarkButtonTemplate}"/>
                <Setter Property="Background"  Value="#B91C1C"/>
                <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="#F85149"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight"  Value="SemiBold"/>
                <Setter Property="FontSize"    Value="13"/>
                <Setter Property="Padding"     Value="14,7"/>
                <Setter Property="Cursor"      Value="Hand"/>
            </Style>

            <!-- ═══════════════════════════════════════════════
                 ACCENT / TEAL BUTTON (NeonGlowButton compat)
            ═══════════════════════════════════════════════ -->
            <Style x:Key="NeonGlowButton" TargetType="{x:Type Button}">
                <Setter Property="Template"    Value="{StaticResource DarkButtonTemplate}"/>
                <Setter Property="Background"  Value="#0F766E"/>
                <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight"  Value="Bold"/>
                <Setter Property="FontSize"    Value="13"/>
                <Setter Property="Padding"     Value="14,7"/>
                <Setter Property="Cursor"      Value="Hand"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#2DD4BF" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════════════════════════════════════
                 GHOST / OUTLINED BUTTON
            ═══════════════════════════════════════════════ -->
            <Style x:Key="OutlinedButton" TargetType="{x:Type Button}">
                <Setter Property="Template"    Value="{StaticResource DarkButtonTemplate}"/>
                <Setter Property="Background"  Value="Transparent"/>
                <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BgBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight"  Value="SemiBold"/>
                <Setter Property="FontSize"    Value="13"/>
                <Setter Property="Padding"     Value="14,7"/>
                <Setter Property="Cursor"      Value="Hand"/>
            </Style>

            <!-- Material Design key aliases so existing views keep working -->
            <Style x:Key="MaterialDesignOutlinedButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}"/>
            <Style x:Key="MaterialDesignFlatButton"     TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}"/>
            <Style x:Key="MaterialDesignRaisedButton"   TargetType="{x:Type Button}" BasedOn="{StaticResource NeonGlowButton}"/>

            <!-- Icon-only button -->
            <Style x:Key="IconButton" TargetType="{x:Type Button}">
                <Setter Property="Template"    Value="{StaticResource DarkButtonTemplate}"/>
                <Setter Property="Background"  Value="Transparent"/>
                <Setter Property="Foreground"  Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding"     Value="6"/>
                <Setter Property="Cursor"      Value="Hand"/>
            </Style>

            <Style x:Key="MaterialDesignIconForegroundButton" TargetType="{x:Type Button}" BasedOn="{StaticResource IconButton}"/>
            <Style x:Key="MaterialDesignIconButton"            TargetType="{x:Type Button}" BasedOn="{StaticResource IconButton}"/>

            <!-- ═══════════════════════════════════════════════
                 TOGGLE BUTTON
            ═══════════════════════════════════════════════ -->
            <Style TargetType="{x:Type ToggleButton}">
                <Setter Property="Background"       Value="Transparent"/>
                <Setter Property="Foreground"       Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="BorderBrush"      Value="Transparent"/>
                <Setter Property="BorderThickness"  Value="0"/>
                <Setter Property="Cursor"           Value="Hand"/>
            </Style>

            <!-- ═══════════════════════════════════════════════
                 TEXT STYLES
            ═══════════════════════════════════════════════ -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <Style x:Key="H1" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="28"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Margin"     Value="0,0,0,16"/>
            </Style>
            <Style x:Key="H2" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Margin"     Value="0,0,0,8"/>
            </Style>
            <Style x:Key="H3" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Margin"     Value="0,0,0,4"/>
            </Style>
            <Style x:Key="Subtitle" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="Margin"     Value="0,0,0,4"/>
            </Style>
            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            </Style>

            <!-- ═══════════════════════════════════════════════
                 TEXTBOX
            ═══════════════════════════════════════════════ -->
            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Background"   Value="{StaticResource BgCardBrush}"/>
                <Setter Property="Foreground"   Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush"  Value="{StaticResource BgBorderBrush}"/>
                <Setter Property="CaretBrush"   Value="{StaticResource AccentBrush}"/>
                <Setter Property="Padding"      Value="8,6"/>
                <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{StaticResource AccentBrush}"/>
            </Style>

            <!-- ═══════════════════════════════════════════════
                 COMBOBOX
            ═══════════════════════════════════════════════ -->
            <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="Background"  Value="{StaticResource BgCardBrush}"/>
                <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BgBorderBrush}"/>
                <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{StaticResource AccentBrush}"/>
            </Style>

            <Style TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Padding"    Value="8,8"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ═══════════════════════════════════════════════
                 LISTBOX
            ═══════════════════════════════════════════════ -->
            <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource {x:Type ListBox}}">
                <Setter Property="Background"    Value="Transparent"/>
                <Setter Property="BorderBrush"   Value="Transparent"/>
            </Style>
            <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Padding"    Value="8"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ═══════════════════════════════════════════════
                 TABCONTROL / TABITEM
            ═══════════════════════════════════════════════ -->
            <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource {x:Type TabControl}}">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
            <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ═══════════════════════════════════════════════
                 DATAGRID
            ═══════════════════════════════════════════════ -->
            <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="Background"             Value="Transparent"/>
                <Setter Property="Foreground"             Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush"            Value="{StaticResource BgBorderBrush}"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BgBorderBrush}"/>
                <Setter Property="VerticalGridLinesBrush"   Value="{StaticResource BgBorderBrush}"/>
                <Setter Property="RowBackground"          Value="Transparent"/>
                <Setter Property="AlternatingRowBackground" Value="{StaticResource BgSurfaceBrush}"/>
            </Style>
            <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="Padding"    Value="10,6"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource {x:Type DataGridCell}}">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Padding"     Value="8,4"/>
            </Style>

            <!-- ═══════════════════════════════════════════════
                 CHECKBOX / RADIO
            ═══════════════════════════════════════════════ -->
            <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>
            <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource {x:Type RadioButton}}">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <!-- ═══════════════════════════════════════════════
                 SCROLLBAR (thin dark)
            ═══════════════════════════════════════════════ -->
            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Width"      Value="6"/>
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <!-- ═══════════════════════════════════════════════
                 SLIDER
            ═══════════════════════════════════════════════ -->
            <Style TargetType="{x:Type Slider}" BasedOn="{StaticResource {x:Type Slider}}">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </Style>

            <!-- ═══════════════════════════════════════════════
                 PROGRESSBAR
            ═══════════════════════════════════════════════ -->
            <Style TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource {x:Type ProgressBar}}">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
            </Style>

            <!-- SEPARATOR -->
            <Style TargetType="{x:Type Separator}" BasedOn="{StaticResource {x:Type Separator}}">
                <Setter Property="Background" Value="{StaticResource BgBorderBrush}"/>
            </Style>

            <!-- Material Design Chip -->
            <Style TargetType="{x:Type materialDesign:Chip}" BasedOn="{StaticResource {x:Type materialDesign:Chip}}">
                <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <!-- Converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
