<Window x:Class="StudyMateAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource BgDeepBrush}"
        FontFamily="Segoe UI"
        Title="StudyMate AI"
        Height="780" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BgDeepBrush}"
            BorderBrush="{DynamicResource BgBorderBrush}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>   <!-- Sidebar -->
                <ColumnDefinition Width="*"/>     <!-- Content -->
            </Grid.ColumnDefinitions>

            <!-- ════════════════════════════════
                 SIDEBAR
            ════════════════════════════════ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BgBorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>

                    <!-- Logo -->
                    <Border DockPanel.Dock="Top"
                            Padding="20,24,20,16"
                            BorderBrush="{DynamicResource BgBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Background="{DynamicResource AccentDarkBrush}"
                                        CornerRadius="10"
                                        Padding="8">
                                    <materialDesign:PackIcon Kind="School"
                                                             Width="28" Height="28"
                                                             Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="StudyMate AI"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Çalışma Asistanı"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Menu Label -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="MENÜ"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="20,16,20,8"/>

                    <!-- Nav Items -->
                    <ListBox x:Name="MenuListBox"
                             SelectionChanged="MenuListBox_SelectionChanged"
                             SelectedIndex="0"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="8,0,8,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="Background"      Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding"         Value="12,0"/>
                                <Setter Property="Height"          Value="42"/>
                                <Setter Property="Margin"          Value="0,2,0,2"/>
                                <Setter Property="Cursor"          Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="NavBg"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="NavBg" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="NavBg" Property="Background" Value="{DynamicResource BgHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboardOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BookOpenPageVariant" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Derslerim" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="RobotOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="AI Asistan" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocument" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Dökümanlar" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarMonth" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Planlayıcı" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PlayCircleOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Video Oynatıcı" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClipboardTextOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Sınav Simülasyonu" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CogOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Ayarlar" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ════════════════════════════════
                 MAIN CONTENT AREA
            ════════════════════════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>  <!-- Topbar -->
                    <RowDefinition Height="*"/>   <!-- Pages -->
                </Grid.RowDefinitions>

                <!-- TOPBAR -->
                <Border Grid.Row="0"
                        Background="{DynamicResource BgSurfaceBrush}"
                        BorderBrush="{DynamicResource BgBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <DockPanel Margin="16,0">
                        <!-- Page Title -->
                        <TextBlock x:Name="PageTitle"
                                   DockPanel.Dock="Left"
                                   Text="Dashboard"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>

                        <!-- Window Controls -->
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Click="MinimizeButton_Click"
                                    Width="36" Height="36"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    ToolTip="Küçült"
                                    Cursor="Hand">
                                <materialDesign:PackIcon Kind="WindowMinimize" Width="14" Height="14"/>
                            </Button>
                            <Button Click="MaximizeButton_Click"
                                    Width="36" Height="36"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    ToolTip="Büyüt/Küçült"
                                    Cursor="Hand">
                                <materialDesign:PackIcon Kind="WindowMaximize" Width="14" Height="14"/>
                            </Button>
                            <Button Click="CloseButton_Click"
                                    Width="36" Height="36"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    ToolTip="Kapat"
                                    Cursor="Hand">
                                <materialDesign:PackIcon Kind="Close" Width="14" Height="14"/>
                            </Button>
                        </StackPanel>

                        <!-- Drag area -->
                        <Border HorizontalAlignment="Stretch"
                                Background="Transparent"
                                MouseDown="DragArea_MouseDown"/>
                    </DockPanel>
                </Border>

                <!-- PAGE FRAME -->
                <Frame x:Name="MainFrame"
                       Grid.Row="1"
                       NavigationUIVisibility="Hidden"
                       Background="{DynamicResource BgDeepBrush}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
