<Page x:Class="StudyMateAI.Views.StudyPlannerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
      xmlns:local="clr-namespace:StudyMateAI.Views" 
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="Çalışma Planlayıcı">
      
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="LocalBoolToVis"/>
        <local:TimerTextConverter x:Key="TimerTextConverter"/>
    </Page.Resources>
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Top Section: Plans and Tasks -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Create & List Plans -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Create New Plan -->
                <Border Grid.Row="0" Padding="20" CornerRadius="8" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Yeni Çalışma Planı" Style="{StaticResource H2}" Margin="0,0,0,16"/>
                        <TextBox Text="{Binding InputTopics, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Konuları Giriniz (virgülle ayırın)..."
                                 AcceptsReturn="True"
                                 Height="80"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding GeneratePlanCommand}" 
                                    Content="{Binding GenerateButtonText}"
                                    Style="{DynamicResource NeonGlowButton}"
                                    Margin="0,0,8,0"/>
                            <Button Command="{Binding AddManualPlanCommand}" 
                                    Content="Manuel Ekle"
                                    Style="{DynamicResource SecondaryButton}"
                                    ToolTip="Yapay zeka kullanmadan direkt ekle"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="2" Text="Planlarım" Style="{StaticResource H2}"/>

                <!-- List of Plans -->
                <Border Grid.Row="4" CornerRadius="8" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1">
                    <ListBox ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}" Background="Transparent" BorderThickness="0" Margin="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,12" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Subject}" FontSize="15" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding TotalTargetHours}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text=" Saat Hedef" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text=" • " Foreground="{DynamicResource TextMutedBrush}" Margin="4,0"/>
                                                <TextBlock Text="{Binding StartDate, StringFormat=dd.MM.yyyy}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Command="{Binding DataContext.CompletePlanCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource IconButton}"
                                                    ToolTip="Planı Tamamla (Arşivle)"
                                                    Margin="0,0,4,0">
                                                <materialDesign:PackIcon Kind="Check" Width="20" Height="20" Foreground="{DynamicResource SuccessBrush}"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.DeletePlanCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource IconButton}"
                                                    ToolTip="Planı Sil">
                                                <materialDesign:PackIcon Kind="Delete" Width="20" Height="20" Foreground="{DynamicResource DangerBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- RIGHT PANEL: Timer & Tasks -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Active Focus UI -->
                <Border Grid.Row="0" Padding="24" CornerRadius="8" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="ŞU AN ÇALIŞILAN KONU" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding SelectedTask.Topic, TargetNullValue='Listeden bir görev seçin...'}" 
                                       FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedTask.Status}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0" 
                                        Visibility="{Binding SelectedTask, Converter={StaticResource LocalBoolToVis}}">
                                <Button Command="{Binding CompleteTaskCommand}" 
                                        Content="Görevi Tamamla" 
                                        Style="{DynamicResource SecondaryButton}"
                                        Margin="0,0,12,0"/>
                                <Button Command="{Binding DeleteTaskCommand}" 
                                        Content="Sil" 
                                        Style="{DynamicResource DangerButton}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TimerDisplay}" FontSize="48" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Command="{Binding ToggleTimerCommand}" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Timer" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding IsTimerRunning, Converter={StaticResource TimerTextConverter}, FallbackValue=Başlat}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SaveSessionCommand}" Content="Kaydet" Style="{DynamicResource SecondaryButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tasks List -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Plan Görevleri" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding DistributeToWeekCommand}" Content="Haftaya Dağıt" 
                                    Style="{DynamicResource OutlinedButton}" 
                                    Margin="0,0,12,0"
                                    Visibility="{Binding SelectedPlan, Converter={StaticResource LocalBoolToVis}}"/>
                            <Button Command="{Binding OpenAddTaskDialogCommand}" Content="+ Görev Ekle" Style="{DynamicResource NeonGlowButton}"/>
                        </StackPanel>
                    </Grid>
                    
                    <Border Grid.Row="2" CornerRadius="8" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1">
                        <ListBox ItemsSource="{Binding CurrentPlanTasks}" SelectedItem="{Binding SelectedTask}" Background="Transparent" BorderThickness="0" Margin="4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,4" Padding="16,12" Background="{DynamicResource BgCardBrush}" CornerRadius="6" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1" Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> 
                                                <ColumnDefinition Width="*"/>    
                                                <ColumnDefinition Width="Auto"/> 
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="4" Background="{DynamicResource BgSurfaceBrush}" Margin="0,0,16,0">
                                                <materialDesign:PackIcon Kind="Book" Height="20" Width="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Topic}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
                                                <ProgressBar Value="{Binding CompletedHours}" Maximum="{Binding EstimatedHours}" Height="6" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource SuccessBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                                <TextBlock VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="{Binding CompletedHours, StringFormat=F1}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <Run Text="/"/>
                                                    <Run Text="{Binding EstimatedHours, StringFormat=F1}"/>
                                                    <Run Text=" Saat"/>
                                                </TextBlock>
                                                
                                                <Button Command="{Binding DataContext.CompleteTaskCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                                                        CommandParameter="{Binding}"
                                                        Style="{DynamicResource IconButton}"
                                                        ToolTip="Tamamla"
                                                        Margin="0,0,4,0">
                                                    <materialDesign:PackIcon Kind="Check" Width="20" Height="20" Foreground="{DynamicResource SuccessBrush}"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                                                        CommandParameter="{Binding}"
                                                        Style="{DynamicResource IconButton}"
                                                        ToolTip="Sil">
                                                    <materialDesign:PackIcon Kind="Delete" Width="20" Height="20" Foreground="{DynamicResource DangerBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        
        <!-- Weekly Schedule Section -->
        <Border Grid.Row="2" Padding="24" CornerRadius="8" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Haftalık Program" Style="{StaticResource H2}" Margin="0,0,0,16"/>
                
                <ItemsControl ItemsSource="{Binding WeeklySchedule}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BgBorderBrush}" 
                                    BorderThickness="0,0,0,1" 
                                    Padding="16,12"
                                    AllowDrop="True"
                                    Drop="DayItem_Drop"
                                    DragOver="DayItem_DragOver"
                                    Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Column="0" Text="{Binding DayName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DateDisplay}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" FontSize="12"/>
                                    
                                    <Border Grid.Column="2" Background="{DynamicResource BgSurfaceBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                                    </Border>
                                    
                                    <TextBlock Grid.Column="3" Text="{Binding HoursDisplay}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentDarkBrush}"/>
                                    <CheckBox Grid.Column="4" IsChecked="{Binding IsCompleted}" Content="✓" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Grid.Column="5" 
                                            Command="{Binding DataContext.DeleteScheduleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{DynamicResource IconButton}"
                                            ToolTip="Temizle">
                                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="{DynamicResource DangerBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</Page>
