<Page x:Class="StudyMateAI.Views.ExamPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:StudyMateAI.Views"
      xmlns:vm="clr-namespace:StudyMateAI.ViewModels"
      xmlns:helpers="clr-namespace:StudyMateAI.Helpers"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
      Title="Sınav Simülasyonu">
    
    <Page.DataContext>
        <vm:ExamViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <helpers:InvertBooleanConverter x:Key="InvertBooleanConverter"/>
    </Page.Resources>

    <Grid Margin="32">
        
        <!-- Loading Overlay -->
        <Border Panel.ZIndex="100" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="#B30B1120"
                Margin="-32">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{DynamicResource MaterialDesignCircularProgressBar}" 
                             IsIndeterminate="True" 
                             Value="0" Width="64" Height="64" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="{Binding LoadingMessage}" Margin="0,24,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- SETUP VIEW -->
        <Grid Visibility="{Binding IsSetupView, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Sınav Simülasyonu" Style="{StaticResource H1}" Margin="0,0,0,32"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Configuration Panel -->
                <Border Grid.Column="0" Padding="32" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1" CornerRadius="8" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Sınav Ayarları" Style="{StaticResource H2}" Margin="0,0,0,24"/>

                        <TextBlock Text="Sınav Tipi" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                        <ComboBox SelectedItem="{Binding ExamType}" Style="{DynamicResource MaterialDesignFilledComboBox}" Margin="0,0,0,24" BorderThickness="0" Background="{DynamicResource BgSurfaceBrush}">
                            <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">Test</sys:String>
                            <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">Klasik</sys:String>
                        </ComboBox>

                        <TextBlock Text="Zorluk Seviyesi" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                        <ComboBox SelectedItem="{Binding Difficulty}" Style="{DynamicResource MaterialDesignFilledComboBox}" Margin="0,0,0,24" BorderThickness="0" Background="{DynamicResource BgSurfaceBrush}">
                            <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">Kolay</sys:String>
                            <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">Orta</sys:String>
                            <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">Zor</sys:String>
                        </ComboBox>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Soru Sayısı" Style="{StaticResource Caption}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding QuestionCount}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider Minimum="1" Maximum="20" Value="{Binding QuestionCount}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,32"/>

                        <Button Command="{Binding StartExamCommand}" Content="SINAVI BAŞLAT" Style="{DynamicResource NeonGlowButton}" Height="48"/>

                        <Border Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,24,0,0">
                            <TextBlock Text="Not: 'Klasik' modda cevaplarınız yapay zeka tarafından değerlendirilip puanlanacaktır." 
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" LineHeight="18"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Source Selection Panel -->
                <Border Grid.Column="2" Padding="32" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Kaynak Seçimi" Style="{StaticResource H2}" Margin="0,0,0,24"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Videolar" IsChecked="{Binding IsVideosSelected}" GroupName="SourceType" Margin="0,0,24,0" Style="{DynamicResource MaterialDesignDarkRadioButton}"/>
                                <RadioButton Content="Dökümanlar" IsChecked="{Binding IsVideosSelected, Converter={StaticResource InvertBooleanConverter}}" GroupName="SourceType" Style="{DynamicResource MaterialDesignDarkRadioButton}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Row="1" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="0,0,0,1" Margin="0,11"/>

                        <Border Grid.Row="2" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                            <Grid>
                                <!-- Video List -->
                                <ListBox ItemsSource="{Binding Videos}" SelectedItem="{Binding SelectedSource}"
                                         Visibility="{Binding IsVideosSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="0,0,0,1">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DateAdded}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Document List -->
                                <ListBox ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedSource}"
                                         Background="Transparent" BorderThickness="0">
                                     <ListBox.Style>
                                        <Style TargetType="ListBox">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVideosSelected}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="0,0,0,1">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding UploadedAt}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- QUIZ VIEW -->
        <Grid Visibility="{Binding IsQuizView, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="Soru " FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentQuestionIndex}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBlock Text="{Binding TotalQuestions, StringFormat='/{0}'}" FontSize="16" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                </StackPanel>
                <Button Content="Sınavı Bitir" HorizontalAlignment="Right" Style="{DynamicResource OutlinedButton}" Command="{Binding NextQuestionCommand}"/>
            </Grid>

            <Border Grid.Row="1" Padding="48" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentQuestion.Question}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,48" LineHeight="32"/>

                        <!-- Options for TEST -->
                        <ItemsControl ItemsSource="{Binding CurrentQuestion.Options}">
                             <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExamType}" Value="Test">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,12">
                                        <RadioButton GroupName="Options" Content="{Binding}" FontSize="16" Style="{DynamicResource MaterialDesignDarkRadioButton}">
                                            <RadioButton.Command>
                                                <Binding Path="DataContext.SubmitAnswerCommand" RelativeSource="{RelativeSource AncestorType=Page}"/>
                                            </RadioButton.Command>
                                            <RadioButton.CommandParameter>
                                                <Binding/>
                                            </RadioButton.CommandParameter>
                                        </RadioButton>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Input for CLASSIC -->
                        <StackPanel>
                             <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExamType}" Value="Klasik">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            
                            <Border Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,24">
                                <TextBox Text="{Binding CurrentQuestion.UserAnswerText, UpdateSourceTrigger=PropertyChanged}" 
                                         AcceptsReturn="True" MinHeight="160" VerticalScrollBarVisibility="Auto"
                                         materialDesign:HintAssist.Hint="Cevabınızı buraya detaylı şekilde yazın..."
                                         Background="Transparent" BorderThickness="0"
                                         materialDesign:TextFieldAssist.DecorationVisibility="Hidden"/>
                            </Border>
                            
                            <Button Content="CEVABI DEĞERLENDİR" 
                                    HorizontalAlignment="Right" 
                                    Command="{Binding EvalulateOpenEndedCommand}"
                                    Style="{DynamicResource NeonGlowButton}"
                                    IsEnabled="{Binding CurrentQuestion.IsEvaluated, Converter={StaticResource InvertBooleanConverter}}"/>

                            <!-- Feedback Area -->
                            <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1" CornerRadius="6" Padding="24" Margin="0,32,0,0">
                                 <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentQuestion.IsEvaluated}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <materialDesign:PackIcon Kind="Sparkles" Width="24" Height="24" Foreground="{DynamicResource InfoBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Yapay Zeka Değerlendirmesi" Style="{StaticResource H2}" Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center" Margin="0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CurrentQuestion.Score, StringFormat='Puan: {0}/100'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,16"/>
                                    <TextBlock Text="{Binding CurrentQuestion.Feedback}" TextWrapping="Wrap" LineHeight="24" FontSize="15"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Button Grid.Row="2" Content="SIRADAKİ SORU" 
                    HorizontalAlignment="Right" 
                    Margin="0,24,0,0" 
                    Height="48"
                    Style="{DynamicResource PrimaryButton}"
                    Command="{Binding NextQuestionCommand}"/>
        </Grid>

        <!-- RESULT VIEW -->
        <Grid Visibility="{Binding IsResultView, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Sınav Sonucu" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,0,0,32"/>

            <!-- Score Card -->
            <Border Grid.Row="1" Padding="48" CornerRadius="12" HorizontalAlignment="Center" Margin="0,0,0,32" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="GENEL PUAN" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Report.Score, StringFormat='{}{0:F0}'}" FontSize="80" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AccentLightBrush}"/>
                </StackPanel>
            </Border>

            <!-- Analysis -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" Padding="32" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Genel Değerlendirme" Style="{StaticResource H2}" Margin="0,0,0,16"/>
                            <TextBlock Text="{Binding Report.OverallAssessment}" TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,32"/>
                            
                            <TextBlock Text="Zayıf Konular" Style="{StaticResource H2}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,16"/>
                            <ItemsControl ItemsSource="{Binding Report.WeakTopics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="16" Height="16" Foreground="{DynamicResource DangerBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2" Padding="32" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1" CornerRadius="8">
                     <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Çalışma Tavsiyeleri" Style="{StaticResource H2}" Margin="0,0,0,16"/>
                            <ItemsControl ItemsSource="{Binding Report.Recommendations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgSurfaceBrush}" Padding="16" Margin="0,0,0,12" CornerRadius="6" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="LightbulbOutline" Width="20" Height="20" Foreground="{DynamicResource WarningBrush}" Margin="0,0,12,0" VerticalAlignment="Top"/>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="22" Width="380"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                
                <Button Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" 
                        Content="YENİ SINAV OLUŞTUR" Command="{Binding ResetExamCommand}" Margin="0,0,0,-24"
                        Style="{DynamicResource NeonGlowButton}" Height="48"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
