<Page x:Class="StudyMateAI.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
      Title="Ayarlar">
      
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48" MaxWidth="800" HorizontalAlignment="Left">
            
            <TextBlock Text="Ayarlar" Style="{StaticResource H1}" Margin="0,0,0,32"/>

            <!-- Ollama Settings -->
            <Border Padding="32" Margin="0,0,0,24" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Background="{DynamicResource BgSurfaceBrush}" CornerRadius="6" Padding="8" Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="Robot" Width="24" Height="24" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <TextBlock Text="Ollama Model Ayarları" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="0"/>
                    </StackPanel>

                    <TextBlock Text="Ollama API URL" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                    <TextBox Text="http://localhost:11434"
                             IsReadOnly="True"
                             Margin="0,0,0,24"
                             Background="{DynamicResource BgDeepBrush}"
                             BorderBrush="{DynamicResource BgBorderBrush}"
                             Foreground="{DynamicResource TextMutedBrush}"
                             Padding="12,8"
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden"/>

                    <!-- Document Model -->
                    <TextBlock Text="Döküman Modeli (Özetleme, Anahtar Kelime)" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" 
                                 x:Name="DocumentModelTextBox"
                                 materialDesign:HintAssist.Hint="Örn: qwen3-vl:235b-cloud"
                                 Background="{DynamicResource BgSurfaceBrush}"
                                 BorderBrush="{DynamicResource BgBorderBrush}"
                                 Padding="12,8"
                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"/>
                        <materialDesign:PackIcon Grid.Column="1" 
                                               x:Name="DocumentModelStatusIcon" 
                                               Kind="CheckCircle" 
                                               Foreground="{DynamicResource SuccessBrush}" 
                                               Visibility="Collapsed" 
                                               VerticalAlignment="Center" 
                                               Margin="12,0,0,0" Width="24" Height="24"/>
                    </Grid>

                    <!-- Chat Model -->
                    <TextBlock Text="AI Asistan Modeli (Genel Sohbet)" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" 
                                 x:Name="ChatModelTextBox"
                                 Background="{DynamicResource BgSurfaceBrush}"
                                 BorderBrush="{DynamicResource BgBorderBrush}"
                                 Padding="12,8"
                                 materialDesign:HintAssist.Hint="Örn: qwen3-vl:235b-cloud"
                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"/>
                        <materialDesign:PackIcon Grid.Column="1" 
                                               x:Name="ChatModelStatusIcon" 
                                               Kind="CheckCircle" 
                                               Foreground="{DynamicResource SuccessBrush}" 
                                               Visibility="Collapsed" 
                                               VerticalAlignment="Center" 
                                               Margin="12,0,0,0" Width="24" Height="24"/>
                    </Grid>
                    
                    <!-- Video Model -->
                    <TextBlock Text="Video Analiz Modeli" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" 
                                 x:Name="VideoModelTextBox"
                                 Background="{DynamicResource BgSurfaceBrush}"
                                 BorderBrush="{DynamicResource BgBorderBrush}"
                                 Padding="12,8"
                                 materialDesign:HintAssist.Hint="Örn: qwen2.5-vl"
                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"/>
                        <materialDesign:PackIcon Grid.Column="1" 
                                               x:Name="VideoModelStatusIcon" 
                                               Kind="CheckCircle" 
                                               Foreground="{DynamicResource SuccessBrush}" 
                                               Visibility="Collapsed" 
                                               VerticalAlignment="Center" 
                                               Margin="12,0,0,0" Width="24" Height="24"/>
                    </Grid>

                    <!-- General Model -->
                    <TextBlock Text="Genel İşler Modeli (Sınav, Planlama vs.)" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 x:Name="GeneralModelTextBox"
                                 Background="{DynamicResource BgSurfaceBrush}"
                                 BorderBrush="{DynamicResource BgBorderBrush}"
                                 Padding="12,8"
                                 materialDesign:HintAssist.Hint="Örn: qwen3-vl:235b-cloud"
                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                 VerticalAlignment="Center"/>
                        
                        <materialDesign:PackIcon Grid.Column="1" 
                                               x:Name="GeneralModelStatusIcon" 
                                               Kind="CheckCircle" 
                                               Foreground="{DynamicResource SuccessBrush}" 
                                               Visibility="Collapsed" 
                                               VerticalAlignment="Center" 
                                               Margin="8,0,0,0" Width="24" Height="24"/>
                        <Button Grid.Column="2"
                                x:Name="SaveButton"
                                Content="Modelleri Kaydet"
                                Click="SaveModel_Click"
                                Style="{DynamicResource NeonGlowButton}"/>
                    </Grid>

                    <Border Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircle" Width="20" Height="20" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Ollama yerel servisi ile bağlantı kuruldu." Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Appearance Settings -->
            <Border Padding="32" Margin="0,0,0,24" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Background="{DynamicResource BgSurfaceBrush}" CornerRadius="6" Padding="8" Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="Palette" Width="24" Height="24" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <TextBlock Text="Görünüm" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="0"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Koyu Tema Kullan (Varsayılan)" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Kullanıcı arayüzü yalnızca koyu tema (Dark Mode) destekleyecek şekilde tasarlanmıştır." FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0"/>
                        </StackPanel>

                        <ToggleButton Grid.Column="1" IsChecked="True" IsEnabled="False" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Database Settings -->
            <Border Padding="32" Margin="0,0,0,24" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Background="{DynamicResource BgSurfaceBrush}" CornerRadius="6" Padding="8" Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="Database" Width="24" Height="24" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <TextBlock Text="Veritabanı Yönetimi" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="0"/>
                    </StackPanel>

                    <TextBlock Text="Tüm verilerinizi (dersler, geçmiş, ayarlar vs.) sıfırlamak için bu seçeneği kullanabilirsiniz. Bu işlem geri alınamaz."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,24" LineHeight="22"/>

                    <Button HorizontalAlignment="Left" Style="{DynamicResource DangerButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteSweep" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Veritabanını Temizle" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Padding="32" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Background="{DynamicResource BgSurfaceBrush}" CornerRadius="6" Padding="8" Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="Information" Width="24" Height="24" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <TextBlock Text="Hakkında" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="0"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Uygulama" Style="{StaticResource Caption}" Margin="0,0,0,16"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="StudyMate AI" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Versiyon" Style="{StaticResource Caption}" Margin="0,0,0,16"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="v1.0.0 (Beta)" Margin="0,0,0,16"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Framework" Style="{StaticResource Caption}" Margin="0,0,0,16"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text=".NET 8.0 WPF" Margin="0,0,0,16"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Model Servisi" Style="{StaticResource Caption}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Ollama Runtime"/>
                    </Grid>

                    <Border BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="0,0,0,1" Margin="0,24"/>

                    <TextBlock Text="StudyMate AI, öğrencilerin ders çalışmalarını kolaylaştırmak için geliştirilmiş yapay zeka destekli bir eğitim asistanıdır."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="20"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
