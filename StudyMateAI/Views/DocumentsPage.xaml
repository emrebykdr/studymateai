<Page x:Class="StudyMateAI.Views.DocumentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:helpers="clr-namespace:StudyMateAI.Helpers"
      TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
      Title="Dökümanlar">
    
    <Page.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.3"
                                     EasingFunction="{StaticResource EaseOut}"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>
    
    <Page.Resources>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Page.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*"/> <!-- Top: PDF Viewer -->
            <RowDefinition Height="*"/>    <!-- Bottom: Lists & Info -->
        </Grid.RowDefinitions>

        <!-- Row 0: PDF Viewer Area -->
        <Border Grid.Row="0" Margin="24,24,24,12" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <!-- Viewer -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                             <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPdfViewerVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <!-- PDF WebView2 requires a white background internally initially to not look broken -->
                    <wpf:WebView2 x:Name="PdfViewer" Source="{Binding PdfSource}" />
                </Grid>
                
                <!-- Placeholder -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPdfViewerVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Background="{DynamicResource BgSurfaceBrush}" Width="96" Height="96" CornerRadius="48" Margin="0,0,0,24" HorizontalAlignment="Center">
                         <materialDesign:PackIcon Kind="FilePdfBox" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                    <TextBlock Text="PDF Görüntüleyici" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Okumak için listeden bir döküman seçin" Style="{StaticResource Subtitle}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Bottom Content Area -->
        <Grid Grid.Row="1" Margin="24,12,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/> <!-- Left: Doc List -->
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>   <!-- Right: Info/AI -->
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Document List -->
            <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" BorderThickness="1" BorderBrush="{DynamicResource BgBorderBrush}" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Klasörler ve Dosyalar" Style="{StaticResource H2}" Margin="0,0,0,16"/>

                    <!-- Folder Selection -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding Folders}"
                                  SelectedItem="{Binding SelectedFolder}"
                                  DisplayMemberPath="Name"
                                  materialDesign:HintAssist.Hint="Klasör Seç"/>
                        
                        <!-- Add Folder Button -->
                        <Button Grid.Column="2" Command="{Binding AddFolderCommand}" Style="{DynamicResource IconButton}" ToolTip="Yeni Klasör Ekle">
                             <materialDesign:PackIcon Kind="FolderPlus" Width="22" Height="22" Foreground="{DynamicResource AccentBrush}"/>
                        </Button>

                        <!-- Delete Folder Button -->
                        <Button Grid.Column="4" Command="{Binding DeleteFolderCommand}" Style="{DynamicResource IconButton}" ToolTip="Klasörü Sil">
                             <materialDesign:PackIcon Kind="Delete" Width="22" Height="22" Foreground="{DynamicResource DangerBrush}"/>
                        </Button>
                    </Grid>
                    
                    <!-- Documents List -->
                    <Border Grid.Row="3" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1" CornerRadius="6">
                        <ListBox ItemsSource="{Binding Documents}" 
                                 SelectedItem="{Binding SelectedDocument}" 
                                 Background="Transparent" BorderThickness="0" Margin="4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <materialDesign:PackIcon Grid.Column="0" Kind="FileDocumentOutline" Width="20" Height="20" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            
                                            <!-- Delete Document -->
                                            <Button Grid.Column="2" 
                                                    Command="{Binding DataContext.DeleteDocumentCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource IconButton}"
                                                    ToolTip="Dökümanı Sil">
                                                <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="{DynamicResource DangerBrush}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    
                    <!-- Upload Button -->
                    <Button Grid.Row="5"
                            Command="{Binding UploadDocumentCommand}"
                            Content="YENİ DÖKÜMAN YÜKLE"
                            Style="{DynamicResource NeonGlowButton}"/>
                </Grid>
            </Border>

            <!-- Right Panel - Details & AI Tools -->
            <Border Grid.Column="2" Background="{DynamicResource BgCardBrush}" BorderThickness="1" BorderBrush="{DynamicResource BgBorderBrush}" CornerRadius="8" Padding="32">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Selected Doc Header -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Döküman Detayları" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding SelectedDocument.Name, TargetNullValue='Seçili Döküman Yok'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <!-- PDF Info Actions -->
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0" Visibility="{Binding SelectedDocument, Converter={StaticResource NullToVisibilityConverter}}">
                             <Button Command="{Binding TogglePdfViewerCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,0,12,0">
                                 <StackPanel Orientation="Horizontal">
                                     <materialDesign:PackIcon Kind="FilePdfBox" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                     <TextBlock Text="PDF Görüntüleyici Aç/Kapat" VerticalAlignment="Center"/>
                                 </StackPanel>
                             </Button>
                             <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}">
                                 <Run Text="Boyut: "/>
                                 <Run Text="{Binding SelectedDocument.FileSize, StringFormat='{}{0:F2} MB'}" FontWeight="Bold"/>
                             </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="0,0,0,1" Margin="0,11"/>

                    <!-- Summarize Actions -->
                    <Grid Grid.Row="2" Visibility="{Binding SelectedDocument, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="AI Özetleme &amp; Analiz" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        
                        <!-- Create Plan Option Button -->
                        <Button Grid.Column="1" Command="{Binding SendDocToPlannerCommand}" Content="Bundan Çalışma Planı Oluştur" Style="{DynamicResource NeonGlowButton}" Margin="0,0,12,0"/>
                        <!-- Summarize -->
                        <Button Grid.Column="1" Command="{Binding SummarizeDocumentCommand}" Content="Özet Çıkar (AI)" Style="{DynamicResource OutlinedButton}" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Scrollable Summary Block -->
                    <Border Grid.Row="3" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <!-- Empty State -->
                            <StackPanel Visibility="{Binding DocumentSummary, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                                <materialDesign:PackIcon Kind="TextBoxSearchOutline" Width="36" Height="36" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Henüz bu doküman için bir özet bulunmuyor." TextAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                            
                            <!-- Summary Result -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding DocumentSummary}" 
                                           TextWrapping="Wrap" 
                                           LineHeight="24"
                                           FontSize="15" 
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Visibility="{Binding DocumentSummary, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                    
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                         <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ProgressBar IsIndeterminate="True" Width="24" Height="24" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="Taranıyor ve özetleniyor..." VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
