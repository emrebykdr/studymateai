<Page x:Class="StudyMateAI.Views.VideoPlayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
      Title="Video Oynatıcı"
      Background="{DynamicResource BgDeepBrush}">
    
    <Page.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.3"
                                     EasingFunction="{StaticResource EaseOut}"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>
    
    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>
        
        <!-- Main Content (Video Area) -->
        <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="0,0,0,1" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Video Oynatıcı" Style="{StaticResource H1}" Margin="0,0,0,4"/>
                            <TextBlock Text="Ders videolarını izle ve analiz et" Style="{StaticResource Subtitle}" Margin="0,0,0,16"/>
                            
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{DynamicResource BgDeepBrush}" CornerRadius="6" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1" Padding="12,4" Margin="0,0,12,0" Width="360">
                                    <TextBox x:Name="UrlTextBox"
                                             materialDesign:HintAssist.Hint="YouTube Video URL'si"
                                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             VerticalAlignment="Center"
                                             Text="{Binding VideoUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                </Border>
                                <Button Content="Yükle"
                                        Command="{Binding LoadVideoCommand}"
                                        Style="{DynamicResource NeonGlowButton}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Kaydet"
                                        Style="{DynamicResource SecondaryButton}"
                                        Command="{Binding SaveVideoCommand}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding CurrentVideo.Title}" FontSize="15" FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Text="{Binding CurrentVideo.Duration, StringFormat='Süre: {0} dk'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,4,0,0" TextAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Video Player -->
                <Border Grid.Row="1" Background="Black" CornerRadius="0,0,8,8" ClipToBounds="True">
                    <wv2:WebView2 x:Name="VideoWebView"/>
                </Border>
            </Grid>
        </Border>

        <!-- Right: AI Chat Panel -->
        <Border Grid.Column="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="RobotOutline" Width="24" Height="24" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="AI Asistan" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="0"/>
                    </StackPanel>
                    
                    <Button Grid.Column="1"
                            Style="{DynamicResource IconButton}"
                            Command="{Binding SummarizeVideoCommand}"
                            ToolTip="Videonun özetini çıkarır (sadece altyazılı videolarda çalışır)">
                         <materialDesign:PackIcon Kind="TextSubject" Width="20" Height="20" Foreground="{DynamicResource InfoBrush}"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                    <ItemsControl ItemsSource="{Binding ChatMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" Margin="0,0,0,12" Background="{DynamicResource BgSurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Role}" 
                                                   FontSize="12"
                                                   FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource AccentLightBrush}"/>
                                        <TextBlock Text="{Binding Content}" 
                                                   TextWrapping="Wrap" 
                                                   Margin="0,6,0,0"
                                                   LineHeight="20"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Input Area -->
                <StackPanel Grid.Row="2">
                    <Button Command="{Binding AnalyzeScreenCommand}"
                            Style="{DynamicResource OutlinedButton}"
                            Height="32"
                            Margin="0,0,0,16"
                            ToolTip="O anki ekran görüntüsünü analiz et">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="MonitorScreenshot" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ekranı Analiz Et" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Background="{DynamicResource BgDeepBrush}" CornerRadius="6" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1" Padding="12,4">
                            <TextBox x:Name="QuestionTextBox"
                                     materialDesign:HintAssist.Hint="Sorunuzu yazın..."
                                     materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Text="{Binding CurrentQuestion, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="False"/>
                        </Border>
                        
                        <Button Grid.Column="2" 
                                Style="{DynamicResource NeonGlowButton}" 
                                Width="36" Height="36" Padding="0">
                            <materialDesign:PackIcon Kind="Send" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}" Margin="2,0,0,0"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
