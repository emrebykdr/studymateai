<Page x:Class="StudyMateAI.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
      Title="Dashboard">
    
    <Page.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.3"
                                     EasingFunction="{StaticResource EaseOut}"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            
            <!-- Welcome Card -->
            <Border Margin="0,0,0,24" Padding="32" CornerRadius="12" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#161B22" Offset="0"/>
                        <GradientStop Color="#0F766E" Offset="1.5"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="Hoş Geldin! 👋" Style="{StaticResource H1}" Margin="0,0,0,4"/>
                    <TextBlock Text="Bugün ne çalışmak istersin?" Style="{StaticResource Subtitle}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Stats Cards -->
            <Grid Margin="0,0,0,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Courses -->
                <Border Grid.Column="0" Padding="24" CornerRadius="8" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="BookOpenPageVariant" Width="36" Height="36" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="TotalCoursesText" Text="0" FontSize="36" FontWeight="Bold" Margin="0,12,0,0"/>
                        <TextBlock Text="Toplam Ders" Style="{StaticResource Subtitle}"/>
                    </StackPanel>
                </Border>

                <!-- Average Grade -->
                <Border Grid.Column="2" Padding="24" CornerRadius="8" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="ChartLine" Width="36" Height="36" Foreground="{DynamicResource InfoBrush}"/>
                        <TextBlock x:Name="AverageGradeText" Text="0.0" FontSize="36" FontWeight="Bold" Margin="0,12,0,0"/>
                        <TextBlock Text="Ortalama Not" Style="{StaticResource Subtitle}"/>
                    </StackPanel>
                </Border>

                <!-- Documents -->
                <Border Grid.Column="4" Padding="24" CornerRadius="8" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="FileDocument" Width="36" Height="36" Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock x:Name="TotalDocumentsText" Text="0" FontSize="36" FontWeight="Bold" Margin="0,12,0,0"/>
                        <TextBlock Text="Döküman" Style="{StaticResource Subtitle}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Active Courses section -->
            <Border Padding="24" CornerRadius="8" Margin="0,0,0,24" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Aktif Dersler" Style="{StaticResource H2}" Margin="0,0,0,16"/>
                    
                    <ListView x:Name="ActiveCoursesListView" 
                              MaxHeight="350"
                              SelectionMode="Single"
                              Background="Transparent"
                              BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,12" 
                                        BorderBrush="{DynamicResource BgBorderBrush}" 
                                        BorderThickness="0,0,0,1"
                                        Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Code}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource BgSurfaceBrush}" CornerRadius="4" Padding="12,6" Margin="0,0,12,0" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Vize " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding MidtermGrade}" FontSize="14" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            
                                            <Border Background="{DynamicResource AccentDarkBrush}" CornerRadius="4" Padding="12,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Final İhtiyacı " FontSize="12" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding RequiredFinalGrade}" FontSize="14" FontWeight="Bold" Foreground="White" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    
                    <TextBlock x:Name="NoCoursesText" 
                               Text="Henüz ders eklenmemiş. 'Derslerim' sayfasından ders ekleyebilirsiniz." 
                               TextAlignment="Center" 
                               Foreground="{DynamicResource TextMutedBrush}" 
                               Margin="0,32,0,16"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Ollama Status -->
            <Border Padding="16" CornerRadius="8" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BgBorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <materialDesign:PackIcon x:Name="OllamaStatusIcon" 
                                             Kind="Circle" 
                                             Width="12" Height="12" 
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock x:Name="OllamaStatusText" 
                               Text="Ollama durumu kontrol ediliyor..." 
                               FontSize="13" 
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="12,0,0,0" 
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
